rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Shared album photos. Anyone with the link can view them and upload a
    // new one (guests don't sign in). Only signed-in admins can remove a
    // photo. Uploads are limited to actual images under 10 MB each.
    match /album/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
