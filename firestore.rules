rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Guests can create their own check-in record when they scan the QR code,
    // and read it back (the document ID acts like a private ticket number).
    // Guests can also list check-ins so the guest-facing scan page can show a
    // live queue position and look up seats already taken at a table.
    // Only signed-in admins can edit or delete check-ins.
    match /checkins/{checkinId} {
      allow get: if true;
      allow list: if true;
      allow create: if (
        request.resource.data.status == 'waiting'
        && request.resource.data.tableId == ''
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
      ) || (
        request.resource.data.status == 'assigned'
        && request.resource.data.tableId is string
        && request.resource.data.tableId.size() > 0
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
      );
      allow update, delete: if request.auth != null;
    }

    // The scan-order counter is incremented by guests during check-in.
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Everyone can view the tables so the live floor plan works for guests.
    // Guests may also add themselves to a table's occupantIds when the scan
    // page auto-seats them (nothing else changes, and the list can only grow
    // or stay the same for a guest, never shrink; that only guards against
    // repeat or duplicate seating attempts, it does not remove anyone).
    // Only signed-in admins can create tables, delete tables, or remove
    // someone from occupantIds.
    match /tables/{tableId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occupantIds'])
        && request.resource.data.occupantIds.size() >= resource.data.occupantIds.size()
      );
    }

    // The guest list can be read by anyone with the check-in link, so the
    // scan page can match a guest's typed name to a predetermined table.
    // Only signed-in admins can add, edit, or delete names on it.
    match /guestList/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event details (party name, date, venue) are public so the scan page
    // can greet guests by name. Only admins can change them.
    match /eventSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Shared album: everyone can see the photos and add their own (the
    // actual image file lives in Google Drive, this is just the info about it).
    // Only signed-in admins can remove a photo's info.
    match /albumPhotos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.fileId is string
        && request.resource.data.uploaderName is string;
      allow delete: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}
